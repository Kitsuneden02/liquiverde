# LiquiVerde - Configuración de Variables de Entorno (.env)

# URL de conexión a la base de datos (por defecto SQLite local en backend/liquiverde.db)
DATABASE_URL=sqlite:///backend/liquiverde.db

# Orígenes permitidos para CORS (separados por coma para FastAPI)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:80,http://localhost

# User-Agent para solicitudes hacia la API de Open Food Facts (requerido por términos de uso de OFF)
OFF_USER_AGENT=LiquiVerde-Chile-App/1.0 (soporte@liquiverde.cl)

# Directorio donde se encuentran los archivos seed (autodetectado si no se especifica)
# DATA_DIR=./data

# Puerto del servidor backend en desarrollo (8000 por defecto)
PORT=8000
